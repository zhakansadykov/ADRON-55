# ============================================================
# Local configuration (holds absolute paths — never committed)
# ============================================================
config/settings.yaml
config/secrets.yaml
config/local_settings.yaml
config/.env
!config/settings.yaml.example

# ============================================================
# Data, results and logs
# ============================================================
# The contents of these directories are ignored, but the directories
# themselves are kept through their .gitkeep files. Ignoring "data/raw/"
# outright would make the negation impossible: git cannot re-include a file
# whose parent directory is excluded.
data/raw/*
data/processed/*
output/*
logs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!output/.gitkeep
!logs/.gitkeep

*.h5
*.hdf5

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg
*.egg-info/
.installed.cfg
MANIFEST

